# ==============================================================================
# Slide-Forge Infrastructure 部署环境变量
# ==============================================================================
# 复制此文件为 .env 并填入实际值
# cp .env.example .env
#
# 这些环境变量将在 CDK 部署时读取，并传递到 ECS 容器中

# ==============================================================================
# 身份认证配置 - 必需
# ==============================================================================
# Cognito 初始管理员邮箱
# CDK 会自动创建此用户并通过邮件发送临时密码
# 示例: admin@example.com
COGNITO_ADMIN_EMAIL=admin@example.com

# ==============================================================================
# CLAUDE AGENT SDK - 必需（二选一）
# ==============================================================================

# 选项 A: 使用 AWS Bedrock (推荐用于 AWS 环境) ✅
CLAUDE_CODE_USE_BEDROCK=1
AWS_REGION=us-east-1
# IAM Role 会自动提供 Bedrock 访问权限

# 选项 B: 使用 Anthropic API (推荐用于快速部署)
# 从 https://console.anthropic.com/ 获取
# ANTHROPIC_API_KEY=sk-ant-api03-...

# ==============================================================================
# AI PROVIDERS - 可选
# ==============================================================================

# OpenAI 或其他兼容 API (可选)
# LLM_API_KEY=sk-...
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL_NAME=gpt-4o-mini

# yunwu.ai API (可选，用于图片生成)
# YUNWU_API_KEY=...

# DashScope API (可选，通义文生图)
# DASHSCOPE_API_KEY=...

# ==============================================================================
# 第三方服务 - 可选
# ==============================================================================

# UploadThing (文件上传服务)
# 从 https://uploadthing.com 获取
# UPLOADTHING_TOKEN=eyJ...

# Tavily API (网络搜索服务)
# 从 https://tavily.com 获取
# TAVILY_API_KEY=tvly-...

# Unsplash API (图片服务)
# 从 https://unsplash.com/developers 获取
# UNSPLASH_ACCESS_KEY=...

# ==============================================================================
# AWS 配置
# ==============================================================================
# 如果使用 AWS Profile (本地开发)
# AWS_PROFILE=default

# 如果使用直接凭证
# AWS_ACCESS_KEY_ID=AKIA...
# AWS_SECRET_ACCESS_KEY=...

# ==============================================================================
# 部署说明
# ==============================================================================
# 1. 复制此文件: cp .env.example .env
# 2. 填入你的 API keys
# 3. 运行部署: pnpm deploy
# 4. CDK 会自动读取 .env 并创建 AWS Secrets Manager 密钥
# 5. 敏感信息会安全地存储在 Secrets Manager 中
