# ==============================================================================
# DATABASE CONFIGURATION
# ==============================================================================
# Docker default (do not change if using docker-compose.yml)
DATABASE_URL="postgresql://presentation_user:presentation_password@localhost:5432/slide_forge"

# ==============================================================================
# AUTHENTICATION
# ==============================================================================
# NextAuth.js configuration
# Generate secret with: openssl rand -base64 32
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:8080"

# AWS Cognito Provider (for user authentication)
# Get from AWS Console > Cognito > User Pools
COGNITO_CLIENT_ID=""
COGNITO_CLIENT_SECRET=""
COGNITO_ISSUER="https://cognito-idp.us-east-1.amazonaws.com/us-east-1_XXXXXXX"

# ==============================================================================
# AI PROVIDERS - TEXT GENERATION (Choose One)
# ==============================================================================

# Option A: OpenAI API
# Get key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=""

# Option B: OpenAI-Compatible API (Recommended)
# Supports: LM Studio, Ollama, vLLM, yunwu.ai, and more
LLM_BASE_URL=""              # e.g., http://localhost:1234/v1
LLM_API_KEY=""               # API key (use "sk-no-key-required" for local)
LLM_MODEL_NAME="gpt-4o-mini" # Model name

# Popular LLM_BASE_URL examples:
# - LM Studio:  http://localhost:1234/v1
# - Ollama:     http://localhost:11434/v1
# - vLLM:       http://localhost:8000/v1
# - yunwu.ai:   https://api.xiaomimimo.com/v1

# ==============================================================================
# AI PROVIDERS - IMAGE GENERATION
# ==============================================================================
# yunwu API for AI image generation (Gemini 3 Pro Image)
# Get key from: https://yunwu.ai
YUNWU_API_KEY=""

# ==============================================================================
# CLAUDE AGENT SDK - AMAZON BEDROCK (For Chat to Slides)
# ==============================================================================
# Enable Claude Agent feature
CLAUDE_CODE_USE_BEDROCK="1"
ENABLE_CLAUDE_AGENT="true"

# AWS Configuration - Choose one method:

# Method 1: AWS Profile (Recommended for local development)
# Configure with: aws configure --profile your-profile-name
AWS_PROFILE="default"
AWS_REGION="us-east-1"

# Method 2: Direct Credentials
# AWS_ACCESS_KEY_ID="AKIA..."
# AWS_SECRET_ACCESS_KEY="..."
# AWS_REGION="us-east-1"

# Method 3: IAM Role (Automatic in AWS environments like EC2/ECS/Lambda)
# Only AWS_REGION is needed, credentials are automatic
# AWS_REGION="us-east-1"

# Required IAM Permissions:
# - bedrock:InvokeModel
# - bedrock:InvokeModelWithResponseStream
# Required Model Access:
# - anthropic.claude-3-5-sonnet
# - anthropic.claude-3-opus (optional)
# - anthropic.claude-3-haiku (optional)

# ==============================================================================
# FILE STORAGE
# ==============================================================================
# UploadThing for file uploads and image storage
# Get token from: https://uploadthing.com
UPLOADTHING_TOKEN=""

# ==============================================================================
# OPTIONAL SERVICES
# ==============================================================================
# Unsplash API for stock images (optional)
# Get key from: https://unsplash.com/developers
UNSPLASH_ACCESS_KEY=""

# Tavily API for web search (optional, used in Chat to Slides)
# Get key from: https://tavily.com
TAVILY_API_KEY=""