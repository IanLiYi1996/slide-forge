#!/bin/bash
# =============================================================================
# Slide Forge AgentCore Startup Script
# =============================================================================
# Starts the FastAPI server using uvicorn on port 8080
# Logs are written to both stdout and a timestamped log file
# =============================================================================

set -e

# Change to app directory (parent of backend module)
cd /app/

# Create logs directory if it doesn't exist
mkdir -p logs

# Add backend to Python path and activate virtual environment
export PYTHONPATH="/app:$PYTHONPATH"
source /app/backend/.venv/bin/activate

# Generate log filename with timestamp
LOG_FILE="logs/server_$(date +%Y%m%d_%H%M%S).log"

echo "========================================"
echo "Slide Forge AgentCore Server Starting..."
echo "========================================"
echo "Working directory: $(pwd)"
echo "Log file: $LOG_FILE"
echo "Port: 8080"
echo "========================================"

# Run server with output to both stdout and log file
# Using 'tee' to duplicate output stream
# Note: backend.server is the module path from /app/
python -m uvicorn backend.server:app --host 0.0.0.0 --port 8080 2>&1 | tee "$LOG_FILE"
