generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
    // NOTE: When using mysql or sqlserver, uncomment the @db.Text annotations in model Account below
    // Further reading:
    // https://next-auth.js.org/adapters/prisma#create-the-prisma-schema
    // https://www.prisma.io/docs/reference/api-reference/prisma-schema-reference#string
    url      = env("DATABASE_URL")
}

// Necessary for Next auth
model Account {
    id                       String  @id @default(cuid())
    userId                   String
    type                     String
    provider                 String
    providerAccountId        String
    refresh_token            String? // @db.Text
    access_token             String? // @db.Text
    expires_at               Int?
    token_type               String?
    scope                    String?
    id_token                 String? // @db.Text
    session_state            String?
    user                     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
    refresh_token_expires_in Int?

    @@unique([provider, providerAccountId])
}

enum UserRole {
    ADMIN
    USER
}

model User {
    id            String    @id @default(cuid())
    name          String?
    email         String?   @unique
    password      String?
    emailVerified DateTime?
    image         String?
    createdAt     DateTime  @default(now())
    updatedAt     DateTime  @default(now()) @updatedAt
    headline      String?   @db.VarChar(100)
    bio           String?   @db.Text
    interests     String[]
    location      String?
    website       String?
    accounts      Account[]

    role      UserRole @default(USER)
    hasAccess Boolean  @default(false)

    // Document system
    documents BaseDocument[]
    favorites FavoriteDocument[]

    CustomTheme CustomTheme[]

    GeneratedImage GeneratedImage[]

    // Agent sessions
    agentSessions AgentSession[]

    // Document processor sessions
    documentProcessorSessions DocumentProcessorSession[]

    // API configuration and usage tracking
    apiConfigurations ApiConfiguration[]
    usageLogs         UsageLog[]
    usageQuotas       UsageQuota[]
    quotaPurchases    QuotaPurchase[]
}

enum DocumentType {
    NOTE
    DOCUMENT
    DRAWING
    DESIGN
    STICKY_NOTES
    MIND_MAP
    RAG
    RESEARCH_PAPER
    FLIPBOOK
    PRESENTATION
}

model BaseDocument {
    id           String        @id @default(cuid())
    title        String
    type         DocumentType
    userId       String
    user         User          @relation(fields: [userId], references: [id])
    thumbnailUrl String?
    createdAt    DateTime      @default(now())
    updatedAt    DateTime      @updatedAt
    isPublic     Boolean       @default(false)
    documentType String
    // Relations to specific document types
    presentation Presentation?

    // Favorites
    favorites FavoriteDocument[]
}

model Presentation {
    id                String       @id @default(cuid())
    content           Json // Presentation content including slides, theme, etc.
    theme             String       @default("default")
    imageSource       String       @default("ai") // The image model used for generating images
    prompt            String? // The prompt used for generating the presentation
    presentationStyle String? // The style of the presentation
    language          String?      @default("en-US") // The language of the presentation
    outline           String[] // Store the presentation outline
    searchResults     Json? // Store the search results
    slideImages       Json? // Store slide image generation history with URLs (slideId -> {imageUrl, conversationHistory})
    base              BaseDocument @relation(fields: [id], references: [id], onDelete: Cascade)
    templateId        String?
    customThemeId     String? // Reference to custom theme if used
    customTheme       CustomTheme? @relation(fields: [customThemeId], references: [id])

    // Session management fields
    generationStage   String?      @default("outline") // outline, slides, completed, exported
    lastAccessedAt    DateTime?    @default(now())
    slidesGenerated   Int?         @default(0) // Count of completed slides
    currentSlideIndex Int?         @default(0) // Last edited slide position

    // Export tracking
    exportedAt        DateTime?
    exportFormat      String? // pdf, pptx, images
    exportCount       Int          @default(0)
    exportHistory     Json? // [{timestamp, format, fileSize, duration}]

    @@index([lastAccessedAt])
    @@index([generationStage])
}

model CustomTheme {
    id            String         @id @default(cuid())
    name          String
    description   String?
    userId        String
    user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
    logoUrl       String?
    isPublic      Boolean        @default(false)
    createdAt     DateTime       @default(now())
    updatedAt     DateTime       @updatedAt
    themeData     Json // Store the complete theme configuration
    presentations Presentation[]

    @@index([userId])
}

model FavoriteDocument {
    id         String       @id @default(uuid())
    documentId String
    document   BaseDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
    userId     String
    user       User         @relation(fields: [userId], references: [id])
}

model GeneratedImage {
    id        String   @id @default(cuid())
    url       String
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
    userId    String
    user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
    prompt    String
}

model AgentSession {
    id                 String   @id @default(cuid())
    userId             String
    user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

    sessionId          String   @unique
    sdkSessionId       String?  @unique  // Agent SDK session ID for resume
    title              String   @default("New Agent Session")
    messages           Json     @default("[]")
    context            Json?
    generatedOutline   String[] @default([])
    generatedSlides    Json?
    presentationId     String?
    status             String   @default("active")

    // Workflow state fields
    workflowStage      String   @default("IDLE")
    workflowState      Json?    // Complete workflow state object
    outline            Json?    // Outline data (array of outline items)
    outlineTitle       String?
    slides             Json?    // All slides data
    currentSlideIndex  Int      @default(0)
    modificationHistory Json?   // Array of modification records

    createdAt          DateTime @default(now())
    updatedAt          DateTime @updatedAt
    lastActivityAt     DateTime @default(now())

    @@index([userId])
    @@index([sessionId])
    @@index([sdkSessionId])  // 添加索引
    @@index([workflowStage])
}

model DocumentProcessorSession {
    id             String   @id @default(cuid())
    userId         String
    user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

    sessionId      String   @unique
    title          String   @default("New Document Session")
    fileName       String?  // Original file name
    fileType       String?  // PDF or image type
    totalPages     Int      @default(0)
    processedPages Int      @default(0)

    // Store images and processing data
    images         Json?    // Array of page images with their data
    processedImages Json?   // Map of processed images by page number
    instructions   Json?    // Array of instructions used for each page

    status         String   @default("active") // active, completed, failed

    // Export tracking
    exportedAt     DateTime?
    exportFormat   String?
    exportCount    Int      @default(0)

    createdAt      DateTime @default(now())
    updatedAt      DateTime @updatedAt
    lastActivityAt DateTime @default(now())

    @@index([userId])
    @@index([sessionId])
    @@index([status])
}

// ============================================
// API Configuration and Usage Tracking System
// ============================================

enum UsageType {
    AI_MODEL_CALL
    SLIDE_GENERATION
    IMAGE_GENERATION
    IMAGE_SEARCH
    STORAGE
    DOCUMENT_PROCESSING
    EXPORT_PDF
    EXPORT_PPTX
}

enum PeriodType {
    DAILY
    WEEKLY
    MONTHLY
    YEARLY
    LIFETIME
}

enum PurchaseStatus {
    PENDING
    COMPLETED
    FAILED
    REFUNDED
}

model ApiConfiguration {
    id          String   @id @default(cuid())
    userId      String
    user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

    apiName     String   // Dynamic API name (e.g., "OPENAI_API", "CUSTOM_LLM")
    displayName String   // User-friendly name for display
    apiKey      String   @db.Text // Encrypted storage
    baseUrl     String?
    metadata    Json?
    isActive    Boolean  @default(true)

    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt

    @@unique([userId, apiName])
    @@index([userId])
    @@index([apiName])
}

model UsageLog {
    id            String    @id @default(cuid())
    userId        String
    user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

    usageType     UsageType
    resourceType  String?
    quantity      Int
    unit          String    @default("count")
    resourceId    String?
    metadata      Json?
    estimatedCost Decimal?  @db.Decimal(10, 4)

    createdAt     DateTime  @default(now())

    @@index([userId])
    @@index([usageType])
    @@index([createdAt])
    @@index([userId, usageType, createdAt])
}

model UsageQuota {
    id             String     @id @default(cuid())
    userId         String
    user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)

    quotaType      UsageType
    baseLimit      Int
    usedAmount     Int        @default(0)
    purchasedLimit Int        @default(0)

    periodType     PeriodType @default(MONTHLY)
    resetAt        DateTime

    createdAt      DateTime   @default(now())
    updatedAt      DateTime   @updatedAt

    @@unique([userId, quotaType])
    @@index([userId])
    @@index([resetAt])
}

model QuotaPurchase {
    id            String         @id @default(cuid())
    userId        String
    user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)

    quotaType     UsageType
    amount        Int
    price         Decimal        @db.Decimal(10, 2)
    paymentMethod String?
    status        PurchaseStatus @default(PENDING)
    transactionId String?
    expiresAt     DateTime?

    createdAt     DateTime       @default(now())
    updatedAt     DateTime       @updatedAt

    @@index([userId])
    @@index([status])
}
