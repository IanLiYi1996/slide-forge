# ==============================================================================
# DATABASE CONFIGURATION
# ==============================================================================
# Docker default (do not change if using docker-compose.yml)
DATABASE_URL="postgresql://presentation_user:presentation_password@localhost:5432/slide_forge"

# ==============================================================================
# AUTHENTICATION
# ==============================================================================
# NextAuth.js configuration
# Generate secret with: openssl rand -base64 32
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:8080"

# AWS Cognito Provider (for user authentication)
# Get from AWS Console > Cognito > User Pools
COGNITO_CLIENT_ID=""
COGNITO_CLIENT_SECRET=""
COGNITO_ISSUER="https://cognito-idp.us-east-1.amazonaws.com/us-east-1_XXXXXXX"

# ==============================================================================
# AI PROVIDERS - TEXT GENERATION
# ==============================================================================
# OpenAI-Compatible API Configuration
# Supports: OpenAI, LM Studio, Ollama, vLLM, yunwu.ai, and more

# Required: API key for your LLM service
# - For OpenAI: Get from https://platform.openai.com/api-keys
# - For local services: Use "sk-no-key-required" or any string
LLM_API_KEY=""

# Optional: Custom base URL (defaults to OpenAI if not set)
# If not configured, requests will be sent to OpenAI's official API
LLM_BASE_URL=""              # e.g., http://localhost:1234/v1

# Model name to use (defaults to gpt-4o-mini)
LLM_MODEL_NAME="gpt-4o-mini"

# Popular LLM_BASE_URL examples:
# - OpenAI (default):  Leave empty or https://api.openai.com/v1
# - LM Studio:         http://localhost:1234/v1
# - Ollama:            http://localhost:11434/v1
# - vLLM:              http://localhost:8000/v1
# - yunwu.ai:          https://api.xiaomimimo.com/v1

# ==============================================================================
# AI PROVIDERS - IMAGE GENERATION (支持多个模型，可选配置)
# ==============================================================================
# yunwu API for AI image generation (Gemini 3 Pro Image)
# Get key from: https://yunwu.ai
YUNWU_API_KEY=""

# 🆕 z-image-turbo API (通义文生图，可选)
# 轻量级文生图模型，支持中英文字渲染，快速生成图像
# Get key from: https://dashscope.aliyuncs.com
DASHSCOPE_API_KEY=""

# ==============================================================================
# CLAUDE AGENT SDK (For Chat to Slides)
# ==============================================================================
# ⚠️ IMPORTANT: Agent SDK 只能在服务端使用 (Next.js API Routes)
# 客户端组件通过 HTTP API 与服务端 Agent 通信

# Enable Claude Agent feature
ENABLE_CLAUDE_AGENT="true"

# -----------------------------------------------------------------------------
# 选项 A: 使用 Anthropic API (推荐用于生产环境)
# -----------------------------------------------------------------------------
# 直接使用 Anthropic API，无需 Claude Code CLI
# Get key from: https://console.anthropic.com/
# ANTHROPIC_API_KEY="sk-ant-api03-..."

# -----------------------------------------------------------------------------
# 选项 B: 使用 Amazon Bedrock (适合 AWS 环境)
# -----------------------------------------------------------------------------
# 通过 AWS Bedrock 访问 Claude 模型
CLAUDE_CODE_USE_BEDROCK="1"

# AWS Configuration - Choose one method:

# Method 1: AWS Profile (Recommended for local development)
# Configure with: aws configure --profile your-profile-name
AWS_PROFILE="default"
AWS_REGION="us-east-1"

# Method 2: Direct Credentials
# AWS_ACCESS_KEY_ID="AKIA..."
# AWS_SECRET_ACCESS_KEY="..."
# AWS_REGION="us-east-1"

# Method 3: IAM Role (Automatic in AWS environments like EC2/ECS/Lambda)
# Only AWS_REGION is needed, credentials are automatic
# AWS_REGION="us-east-1"

# Required IAM Permissions:
# - bedrock:InvokeModel
# - bedrock:InvokeModelWithResponseStream
# Required Model Access:
# - anthropic.claude-3-5-sonnet
# - anthropic.claude-3-opus (optional)
# - anthropic.claude-3-haiku (optional)

# -----------------------------------------------------------------------------
# 部署说明
# -----------------------------------------------------------------------------
# 1. 本地开发: 使用选项 A (ANTHROPIC_API_KEY) 或选项 B (AWS Profile)
# 2. Docker 部署: 需要安装 Claude Code CLI 在容器中
#    - 方式 1: 在 Dockerfile 中添加: RUN npm install -g @anthropic-ai/claude-code
#    - 方式 2: 使用 ANTHROPIC_API_KEY 环境变量 (无需安装 Claude Code)
# 3. AWS Lambda/ECS: 使用选项 B (IAM Role) 或选项 A (API Key)

# ==============================================================================
# FILE STORAGE
# ==============================================================================
# UploadThing for file uploads and image storage
# Get token from: https://uploadthing.com
UPLOADTHING_TOKEN=""

# ==============================================================================
# OPTIONAL SERVICES
# ==============================================================================
# Unsplash API for stock images (optional)
# Get key from: https://unsplash.com/developers
UNSPLASH_ACCESS_KEY=""

# Tavily API for web search (optional, used in Chat to Slides)
# Get key from: https://tavily.com
TAVILY_API_KEY=""

# ==============================================================================
# SECURITY & USAGE TRACKING
# ==============================================================================
# API Key Encryption - Required for API configuration management
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=""

# Cron Job Secret - Required for automated quota resets
# Generate with: openssl rand -base64 32
CRON_SECRET=""