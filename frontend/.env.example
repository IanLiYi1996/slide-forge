# ==============================================================================
# SLIDE FORGE - Environment Configuration
# ==============================================================================
# Copy this file to .env and fill in your values

# ==============================================================================
# AUTHENTICATION
# ==============================================================================
# NextAuth.js configuration
# Generate secret with: openssl rand -base64 32
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# AWS Cognito Provider (for user authentication)
# Get from AWS Console > Cognito > User Pools
COGNITO_CLIENT_ID=""
COGNITO_CLIENT_SECRET=""
COGNITO_ISSUER="https://cognito-idp.us-east-1.amazonaws.com/us-east-1_XXXXXXX"

# ==============================================================================
# AI PROVIDERS - TEXT GENERATION (选择一种)
# ==============================================================================

# 选项 A: OpenAI-Compatible API
# Supports: OpenAI, LM Studio, Ollama, yunwu.ai, etc.
LLM_API_KEY=""
LLM_BASE_URL=""              # 留空使用 OpenAI，或设置自定义地址
LLM_MODEL_NAME="gpt-4o-mini"

# 选项 B: AWS Bedrock (推荐)
# 通过 AWS Bedrock 访问 Claude 模型
CLAUDE_CODE_USE_BEDROCK="1"
AWS_PROFILE="default"        # 本地开发使用 AWS 配置文件
AWS_REGION="us-east-1"

# ==============================================================================
# S3 STORAGE (Session Data)
# ==============================================================================
# S3 bucket for storing session data (outline, pages, etc.)
# Can use deployed bucket or create your own
UPLOADS_BUCKET=""

# ==============================================================================
# AI PROVIDERS - IMAGE GENERATION (至少配置一个)
# ==============================================================================

# yunwu API (Gemini 3 Pro Image)
# Get key from: https://yunwu.ai
YUNWU_API_KEY=""

# 通义万相 z-image-turbo (可选)
# Get key from: https://dashscope.aliyuncs.com
DASHSCOPE_API_KEY=""

# ==============================================================================
# FILE STORAGE
# ==============================================================================
# UploadThing for file uploads
# Get token from: https://uploadthing.com
UPLOADTHING_TOKEN=""

# ==============================================================================
# OPTIONAL SERVICES
# ==============================================================================

# Tavily API for web search in outline generation
# Get key from: https://tavily.com
TAVILY_API_KEY=""

# Unsplash API for stock images
# Get key from: https://unsplash.com/developers
UNSPLASH_ACCESS_KEY=""

# Claude Agent feature toggle
ENABLE_CLAUDE_AGENT="true"
